// PCM Study Platform — normalized domain schema (SQLite)
// Note: SQLite via Prisma 5 does not support Json or native enums; use String fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  chartColor String?
  chapters   Chapter[]
  flashcards Flashcard[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Source {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  chapters  Chapter[]
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Difficulty {
  id                 String     @id @default(cuid())
  name               String     @unique
  slug               String     @unique
  sortOrder          Int        @default(0)
  questions          Question[]
  displayForChapters Chapter[]  @relation("ChapterDisplayDifficulty")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Chapter {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String
  /// TOPIC | LEVEL | CHAPTER (stored as string; SQLite has no enum support in Prisma 5)
  nodeType             String            @default("CHAPTER")
  catalogQuestionCount Int?
  subjectId            String
  subject              Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sourceId             String?
  source               Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  parentId             String?
  parent               Chapter?          @relation("ChapterHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children             Chapter[]         @relation("ChapterHierarchy")
  concepts             Concept[]
  displayDifficultyId  String?
  displayDifficulty    Difficulty?       @relation("ChapterDisplayDifficulty", fields: [displayDifficultyId], references: [id])
  questionChapters     QuestionChapter[]
  flashcards           Flashcard[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([subjectId, slug])
}

model Concept {
  id               String            @id @default(cuid())
  name             String
  slug             String
  chapterId        String?
  chapter          Chapter?          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionConcepts QuestionConcept[]
  flashcards       Flashcard[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([chapterId, slug])
}

model Question {
  id                      Int                       @id @default(autoincrement())
  content                 String
  questionNumber          Int?
  sourceId                String
  source                  Source                    @relation(fields: [sourceId], references: [id])
  difficultyId            String
  difficulty              Difficulty                @relation(fields: [difficultyId], references: [id])
  isDue                   Boolean                   @default(false)
  chapters                QuestionChapter[]
  concepts                QuestionConcept[]
  // Mastery tracking for spaced repetition
  masteryScore            Float                     @default(0.5)
  lastSeen                DateTime?
  totalAttempts           Int                       @default(0)
  fastSuccesses           Int                       @default(0)
  slowSuccesses           Int                       @default(0)
  failures                Int                       @default(0)
  skips                   Int                       @default(0)
  consecutiveFastSuccesses Int                      @default(0)
  // Relations
  practiceAttempts        PracticeQuestionAttempt[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model QuestionChapter {
  questionId Int
  chapterId  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([questionId, chapterId])
}

model QuestionConcept {
  questionId Int
  conceptId  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
}

model Flashcard {
  id           Int       @id @default(autoincrement())
  front        String
  back         String
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId    String?
  chapter      Chapter?  @relation(fields: [chapterId], references: [id])
  conceptId    String?
  concept      Concept?  @relation(fields: [conceptId], references: [id])
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Seeded UI analytics snapshots (dashboard/statistics charts). JSON stored as string for SQLite.
model MetricSnapshot {
  key  String @id
  data String
}

model PracticeSession {
  id                      String                    @id @default(cuid())
  sessionDuration         Int                       // total session duration in seconds
  targetTimePerQuestion   Float                     // target time per question in minutes
  selectedQuestions       String                    // JSON array of question IDs for this session
  filterCriteria          String                    // JSON object with subjectIds, sourceIds, chapterIds, difficultyIds
  startedAt               DateTime
  endedAt                 DateTime?
  practiceAttempts        PracticeQuestionAttempt[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model PracticeQuestionAttempt {
  id                String            @id @default(cuid())
  sessionId         String
  session           PracticeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId        Int
  question          Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  outcome           String            // 'solved-fast' | 'solved-slow' | 'failed' | 'skipped'
  confidence        Int               @default(3)
  errorType         String            @default("calculation")
  questionType      String            @default("numerical")
  tags              String            @default("[]")
  startedAt         DateTime
  endedAt           DateTime
  elapsedSeconds    Int               // total elapsed time for this question
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([sessionId])
  @@index([questionId])
}
